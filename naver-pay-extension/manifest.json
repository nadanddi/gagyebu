{
  "manifest_version": 3,
  "name": "네이버페이 가계부 동기화",
  "version": "0.1.0",
  "description": "로그인된 네이버페이 결제내역을 읽어 개인 Google Sheets 가계부와 맞춥니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pay.naver.com/*",
    "https://orders.pay.naver.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pay.naver.com/pc/history*"],
      "js": ["parser.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "네이버페이 가계부 동기화"
  }
}
